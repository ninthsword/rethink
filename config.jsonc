{
  // Used to name rethink to the appliances, and so it must be a name they can resolve.
  // The original setup earns that by redirecting DNS long enough to re-provision each
  // appliance onto this name. Where a firewall rule does the redirecting instead, this
  // name was never published anywhere: set "route_servers" below, or an appliance that
  // asks where its servers are will be handed an address that does not exist and stop
  // dialling until its power is cycled.
  "hostname": "rethink.lan", // this can't be an IP address

  "homeassistant": {
    "mqtt_url": "mqtt://localhost:1883",
    "discovery_prefix": "homeassistant", // corresponds to discovery_prefix in homeassistant config
    "rethink_prefix": "rethink", // rethink topics will be prefixed with this
    "language": "korean", // "english" or "korean" for entity names and appliance states
    // Seconds a disconnected appliance keeps its entities available. LG appliances
    // drop their MQTT session while idle, so a short grace makes every entity flip
    // to "unavailable" on the appliance's own standby cycle.
    "offline_grace_seconds": 1800,
    "mqtt_user": "",
    "mqtt_pass": ""

    // Air conditioners that share an outdoor unit. Each indoor head reports the outdoor
    // unit's power rather than its own share, and only while it is itself running, so
    // their totals can be neither added nor taken one at a time. The first appliance of
    // each group carries the group's power and energy sensors; the heads keep their own
    // power reading and none of them carries a total.
    //  "outdoor_units": [
    //    { "name": "living room / bedroom 2-in-1", "devices": ["<id>", "<id>"] }
    //  ]
  },

  "ca_key_file": "ca.key", // will be created on first run if necessary
  "ca_cert_file": "ca.cert", // will be created on first run if necessary
  // Generate a CA-signed leaf certificate for every TLS SNI hostname.
  "sni_certificates": true,

  // What to tell an appliance its servers are when it asks. Leave it out to name rethink
  // itself, which is right when the appliances were pointed here deliberately. With a
  // firewall rule doing the redirecting, name the appliances' own servers instead: they
  // keep addresses that resolve, and the rule goes on redirecting them. The values are
  // whatever the appliances report as api-server and mqtt-server when they announce.
  //  "route_servers": {
  //    "apiServer": "https://kic-common.lgthinq.com:443",
  //    "mqttServer": "ssl://common.iot.kic.lgthinq.com:8883"
  //  },

  // Hosts to splice through to the real server rather than answer here. A firewall rule
  // on port 443 catches every host an appliance talks to, including ones rethink has no
  // routes for; offering a certificate for one of those only produces a refusal the
  // appliance retries about once a second, indefinitely. Empty by default, because
  // anything listed here leaves the house.
  //
  // Listing a host here also stops rethink from seeing anything the appliance sends
  // over it: a passed-through connection is spliced byte for byte, encrypted end to
  // end between the appliance and LG. Some appliances treat a reachable LG host as
  // permission to report their state there instead of over MQTT, and then rethink
  // holds a live-looking connection while its own values never arrive -- the cloud
  // and the ThinQ app stay current, Home Assistant goes stale. Adding a host to
  // silence a refusal storm is not free; check afterwards that every appliance still
  // reaches "received initial values".
  //  "passthrough_hostnames": ["*mclip*"],

  // The other way to quiet a host rethink cannot serve: accept the connection and answer
  // it with nothing at all, closing it a minute later. rethink cannot produce a
  // certificate the appliance will accept for such a host — the appliance only ever
  // refreshes its aws-iot trust slot, and whatever slot it validates these against keeps
  // LG's own CA — so the choice is between refusing instantly and saying nothing. Refused,
  // the appliance asks again about once a second for as long as it is powered; held, it
  // waits out its own timeout. Unlike passing the host through, this gives the appliance
  // no working route to LG, so it keeps reporting its state over MQTT to rethink.
  //  "stall_hostnames": ["*mclip*"],

  // If port forwarding or other redirection is involved, the bind port may not match
  // the port that the device will connect to from the outside.
  // In such cases, you may need to specify them separately:
  //  "https_port": { "bind": 4433, "advertise": 443 },
  // or not
  //  "https_port": 443,
  // Note that diverging from the defaults (443 & 8883) may degrade compatibility with
  // some devices
  "https_port": { "bind": 4433, "advertise": 443 },
  "mqtts_port": 8883,

  // useful for local testing & debugging, not used by Thinq2
  "mqtt_port": 1884,

  // the defaults should not be changed unless you know what you're doing
  "thinq1_https_port": 46030,
  "thinq1_port": 47878,

  // specify anything you like. Removing this parameter disables the management interface
  "management_port": 44401,

  // The management interface has no authentication. It binds to 127.0.0.1 unless you say
  // otherwise, so reaching it means being on this host or forwarding a port over SSH:
  //   ssh -N -L 44401:127.0.0.1:44401 <this host>
  // Set "0.0.0.0" to open it to the whole LAN, or a single interface address to narrow that.
  // "management_host": "0.0.0.0",

  "bridge": {
    "storage_path": "./state",
    // Keep existing ThinQ2 registration, aliases, LG app and Google Home links.
    "preserve_existing_devices": true
  },

  "log": ["status", "incoming", "HTTPS", "publish", "MGMT"]
}
